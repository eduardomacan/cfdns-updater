#!/usr/bin/bash

CONFIG_FILE="/etc/cfdns-updater.env"

set -a
if [ -f $CONFIG_FILE ]; then
    source $CONFIG_FILE
fi
set +a

RUN_ONCE=false
FORCE_UPDATE=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        -n|--run-once)
            RUN_ONCE=true
            ;;
        -f|--force)
            FORCE_UPDATE=true
            ;;
        -h|--help)
            echo "Usage: $0 [OPTIONS]"
            echo "Options:"
            echo "  -n, --run-once  Run once and exit (don't run as daemon)"
            echo "  -f, --force     Force update even if IP hasn't changed"
            echo "  -h, --help      Show this help message"
            exit 0
            ;;
        *)
            echo "Unknown option: $1"
            exit 1
            ;;
    esac
    shift
done

if [ -z "$CLOUDFLARE_ZONE_ID" ] || [ -z "$CLOUDFLARE_DNS_RECORD_ID" ] || [ -z "$CLOUDFLARE_API_TOKEN" ] || [ -z "$DNS_RECORD" ]; then
    echo "Error: Missing required environment variables"
    echo "Required: CLOUDFLARE_ZONE_ID, CLOUDFLARE_DNS_RECORD_ID, CLOUDFLARE_API_TOKEN, DNS_RECORD"
    exit 1
fi

IP_FILE="/run/cfdns-lastip"
CHECK_INTERVAL=300
RETRY_INTERVAL=60
# Compare against the actual Cloudflare record every N checks (and on startup)
VERIFY_EVERY=12

CURL_OPTS=(--silent --show-error --max-time 15 --connect-timeout 5)
CF_API="https://api.cloudflare.com/client/v4/zones/$CLOUDFLARE_ZONE_ID/dns_records/$CLOUDFLARE_DNS_RECORD_ID"

log() {
    echo "[$(date -Iseconds)] $1"
}

is_valid_ip() {
    [[ "$1" =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]] || return 1
    local octet
    for octet in "${BASH_REMATCH[@]:1}"; do
        (( 10#$octet <= 255 )) || return 1
    done
}

get_current_ip() {
    local ip
    ip=$(curl "${CURL_OPTS[@]}" --fail -4 https://checkip.amazonaws.com) || return 1
    ip=$(echo "$ip" | tr -d '[:space:]')
    is_valid_ip "$ip" || return 1
    echo "$ip"
}

# Prints the IP currently stored in the Cloudflare record
get_dns_ip() {
    local response ip
    response=$(curl "${CURL_OPTS[@]}" "$CF_API" \
        -H "Authorization: Bearer $CLOUDFLARE_API_TOKEN") || return 1
    echo "$response" | grep -q '"success":[[:space:]]*true' || return 1
    ip=$(echo "$response" | grep -o '"content":[[:space:]]*"[^"]*"' | head -n1 | sed 's/.*"\([^"]*\)"$/\1/')
    is_valid_ip "$ip" || return 1
    echo "$ip"
}

# Returns 0 only if Cloudflare confirms the update
update_dns() {
    local ip="$1"
    local now=$(date -Iseconds)
    local response
    log "Updating $DNS_RECORD with IP $ip"

    QUERY="{
          \"name\": \"$DNS_RECORD\",
          \"ttl\": 3600,
          \"type\": \"A\",
          \"comment\": \"UPDATED VIA SCRIPT ON $now\",
          \"content\": \"$ip\",
          \"proxied\": false
        }"

    response=$(curl "${CURL_OPTS[@]}" "$CF_API" \
        -X PUT \
        -H 'Content-Type: application/json' \
        -H "Authorization: Bearer $CLOUDFLARE_API_TOKEN" \
        -d "$QUERY")
    local rc=$?

    if [ $rc -ne 0 ]; then
        log "Cloudflare request failed (curl exit $rc)"
        return 1
    fi
    if ! echo "$response" | grep -q '"success":[[:space:]]*true'; then
        log "Cloudflare update failed: $response"
        return 1
    fi
    log "Cloudflare update succeeded"
}

# Sleep in the background so SIGTERM is handled immediately
wait_for() {
    sleep "$1" &
    wait $!
}

log "Starting DNS updater service"

cleanup() {
    log "Received shutdown signal, exiting gracefully"
    exit 0
}

trap cleanup SIGTERM SIGHUP

check_count=0

while true; do
    if ! current_ip=$(get_current_ip); then
        log "Failed to get a valid current IP, retrying in ${RETRY_INTERVAL}s"
        [ "$RUN_ONCE" = true ] && exit 1
        wait_for $RETRY_INTERVAL
        continue
    fi

    last_ip=""
    if (( check_count % VERIFY_EVERY == 0 )) || [ ! -f "$IP_FILE" ]; then
        if last_ip=$(get_dns_ip); then
            echo "$last_ip" > "$IP_FILE"
        else
            log "Could not read current record from Cloudflare, falling back to cached IP"
            last_ip=""
            [ -f "$IP_FILE" ] && last_ip=$(cat "$IP_FILE")
        fi
    else
        last_ip=$(cat "$IP_FILE")
    fi

    update_ok=true
    if [ "$current_ip" != "$last_ip" ]; then
        log "IP changed: $last_ip -> $current_ip"
        update_dns "$current_ip" || update_ok=false
    elif [ "$FORCE_UPDATE" = true ]; then
        log "IP unchanged ($current_ip), forcing update"
        update_dns "$current_ip" || update_ok=false
    else
        log "IP unchanged ($current_ip)"
    fi

    if [ "$update_ok" = true ]; then
        echo "$current_ip" > "$IP_FILE"
    else
        # Don't cache the IP so the next check retries the update
        rm -f "$IP_FILE"
    fi

    if [ "$RUN_ONCE" = true ]; then
        [ "$update_ok" = true ] && exit 0 || exit 1
    fi

    check_count=$((check_count + 1))
    if [ "$update_ok" = true ]; then
        wait_for $CHECK_INTERVAL
    else
        log "Retrying in ${RETRY_INTERVAL}s"
        wait_for $RETRY_INTERVAL
    fi
done
